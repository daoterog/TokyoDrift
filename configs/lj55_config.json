{
  "system": "lj55",
  "drift": {
    "space": "particle_coordinates",
    "kernel": "gaussian",
    "normalized": false,
    "descriptors": true
  },
  "data": "data/lj55/dataset.npz",
  "output": "results/lj55/gaussian/checkpoints",
  "seed": 42,
  "model": {
    "feature_dim": 8,
    "hidden_dim": 256,
    "layers": 9,
    "radial_basis": 16,
    "max_distance": 4.0
  },
  "training": {
    "epochs": 100,
    "batch_size": 512,
    "positive_references": 512,
    "coordinate_noise_scale": 1.0,
    "bandwidth": [0.02, 0.05, 0.1, 0.15],
    "bandwidth_scale_start": 1.0,
    "bandwidth_scale_end": 0.5,
    "bandwidth_anneal_start": 50,
    "bandwidth_anneal_end": 100,
    "eta": 0.5,
    "repulsion": 1.0,
    "min_radius_fraction": 0.25,
    "learning_rate": 0.0002,
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "ema_decay": 0.999,
    "log_every": 1,
    "checkpoint_every": 6
  }
}
