{
  "system": "dw4",
  "drift": {
    "space": "particle_coordinates",
    "kernel": "gaussian",
    "normalized": false,
    "descriptors": true
  },
  "data": "data/dw4/dataset.npz",
  "output": "results/dw4/checkpoints",
  "seed": 42,
  "model": {
    "architecture": "egnn",
    "variant": "bounded",
    "coordinate_range": 1.0,
    "feature_dim": 8,
    "hidden_dim": 128,
    "layers": 6,
    "radial_basis": 24,
    "max_distance": 8.0
  },
  "training": {
    "epochs": 1000,
    "batch_size": 2048,
    "positive_references": 2048,
    "coordinate_noise_scale": 1.0,
    "bandwidth": [0.2, 0.5, 1.0, 2.0],
    "bandwith_scale_start": 1.0,
    "bandwith_scale_end": 0.5,
    "bandwith_anneal_start": 400,
    "bandwith_anneal_end": 1000,
    "eta": 1.0,
    "repulsion": 1.0,
    "min_radius_fraction": 0.25,
    "learning_rate": 0.0002,
    "learning_rate_end": 0.00002,
    "learning_rate_decay_start": 500,
    "learning_rate_decay_end": 1000,
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "ema_decay": null,
    "log_every": 2,
    "early_stopping_epsilon": 0.000001,
    "early_stopping_patience": 500,
    "validation_holdout": 10000,
    "validation_every": 20,
    "validation_generated_samples": 10000,
    "validation_batch_size": 512,
    "validation_positive_references": 1024,
    "track_train_test_metrics": true,
    "tracking_every": 20,
    "tracking_generated_samples": 10000,
    "tracking_batch_size": 512,
    "tracking_positive_references": 1024,
    "tracking_reference_samples": 10000
  }
}
