{
  "system": "lj13",
  "drift": {
    "space": "particle_coordinates",
    "kernel": "gaussian",
    "normalized": false,
    "descriptors": true
  },
  "data": "data/lj13/dataset.npz",
  "output": "results/lj13/checkpoints",
  "seed": 42,
  "model": {
    "architecture": "egnn",
    "feature_dim": 8,
    "hidden_dim": 128,
    "layers": 9,
    "radial_basis": 24,
    "max_distance": 8.0
  },
  "training": {
    "epochs": 500,
    "batch_size": 2048,
    "positive_references": 2048,
    "coordinate_noise_scale": 1.0,
    "bandwidth": [0.1, 0.15, 0.3, 0.5],
    "eta": 1.0,
    "repulsion": 1.0,
    "min_radius_fraction": 0.25,
    "learning_rate": 0.0002,
    "learning_rate_end": 0.00002,
    "learning_rate_decay_start": 300,
    "learning_rate_decay_end": 1000,
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "ema_decay": null,
    "log_every": 2,
    "checkpoint_every": 20
  }
}
