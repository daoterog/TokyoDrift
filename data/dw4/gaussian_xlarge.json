{
  "system": "dw4",
  "drift": {
    "space": "particle_coordinates",
    "kernel": "gaussian",
    "normalized": false
  },
  "data": "data/dw4/dataset.npz",
  "output": "artifacts/runs/dw4/gaussian-xlarge",
  "seed": 42,
  "model": {
    "feature_dim": 8,
    "hidden_dim": 192,
    "layers": 8,
    "radial_basis": 32,
    "max_distance": 8.0
  },
  "training": {
    "epochs": 1021,
    "batch_size": 2048,
    "positive_references": 2048,
    "coordinate_noise_scale": 2.5,
    "bandwidth": "auto",
    "bandwidth_scale_start": 1.5,
    "bandwidth_scale_end": 0.5,
    "bandwidth_anneal_start": 204,
    "bandwidth_anneal_end": 612,
    "eta": 0.2,
    "repulsion": 1.0,
    "min_radius_fraction": 0.25,
    "learning_rate": 0.0002,
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "ema_decay": 0.999,
    "log_every": 2,
    "checkpoint_every": 20
  }
}
