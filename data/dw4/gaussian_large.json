{
  "system": "dw4",
  "drift": {
    "space": "particle_coordinates",
    "kernel": "gaussian",
    "normalized": false
  },
  "data": "data/dw4/dataset.npz",
  "output": "artifacts/runs/dw4/gaussian-large",
  "seed": 42,
  "model": {
    "feature_dim": 8,
    "hidden_dim": 128,
    "layers": 6,
    "radial_basis": 24,
    "max_distance": 8.0
  },
  "training": {
    "epochs": 1000,
    "batch_size": 2048,
    "positive_references": 2048,
    "coordinate_noise_scale": 1.0,
    "bandwidth": [0.1, 0.5, 1.0, 1.5],
    "eta": 1.0,
    "repulsion": 1.0,
    "min_radius_fraction": 0.25,
    "learning_rate": 0.0002,
    "learning_rate_end": 0.00002,
    "learning_rate_decay_start": 500,
    "learning_rate_decay_end": 1000,
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "ema_decay": null,
    "log_every": 2,
    "checkpoint_every": 20
  }
}
