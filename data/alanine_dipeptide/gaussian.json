{
  "system": "aldp",
  "drift": {
    "space": "particle_coordinates",
    "kernel": "gaussian",
    "normalized": false,
    "descriptors": true
  },
  "data": "data/alanine_dipeptide/dataset.npz",
  "output": "results/alanine_dipeptide/gaussian/checkpoints",
  "seed": 42,
  "model": {
    "feature_dim": 22,
    "fixed_atom_identity": true,
    "hidden_dim": 256,
    "layers": 9,
    "radial_basis": 24,
    "max_distance": 8.0
  },
  "training": {
    "epochs": 3000,
    "batch_size": 2048,
    "positive_references": 2048,
    "coordinate_noise_scale": 1.0,
    "bandwidth": [0.1, 0.3, 0.6, 1.8],
    "eta": 0.5,
    "repulsion": 1.0,
    "min_radius_fraction": 0.25,
    "learning_rate": 0.0002,
    "learning_rate_end": 0.00002,
    "learning_rate_decay_start": 300,
    "learning_rate_decay_end": 500,
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "ema_decay": null,
    "log_every": 2,
    "checkpoint_every": 20,
    "validation_split": "validation",
    "validation_every": 20,
    "validation_generated_samples": 4096,
    "validation_batch_size": 256,
    "validation_positive_references": 1024,
    "validation_metric": "selection_score"
  }
}
