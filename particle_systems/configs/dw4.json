{
  "system": "dw4",
  "data": "particle_systems/data/dw4.npz",
  "output": "particle_systems/runs/dw4",
  "seed": 42,
  "model": {
    "feature_dim": 8,
    "hidden_dim": 64,
    "layers": 4,
    "radial_basis": 16,
    "max_distance": 8.0
  },
  "training": {
    "steps": 30000,
    "batch_size": 256,
    "positive_references": 256,
    "coordinate_noise_scale": 2.5,
    "bandwidth": "auto",
    "eta": 0.2,
    "repulsion": 0.3,
    "learning_rate": 0.0002,
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "ema_decay": 0.999,
    "log_every": 100,
    "checkpoint_every": 5000
  }
}
