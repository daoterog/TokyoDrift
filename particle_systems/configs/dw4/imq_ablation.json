{
  "system": "dw4",
  "data": "particle_systems/data/dw4.npz",
  "output": "particle_systems/artifacts/runs/dw4/imq-ablation",
  "seed": 42,
  "model": {
    "feature_dim": 8,
    "hidden_dim": 64,
    "layers": 4,
    "radial_basis": 16,
    "max_distance": 8.0
  },
  "training": {
    "steps": 50000,
    "batch_size": 256,
    "positive_references": 1024,
    "coordinate_noise_scale": 2.5,
    "bandwidth": "auto",
    "bandwidth_scale_start": 0.5,
    "bandwidth_scale_end": 0.5,
    "kernel": "imq",
    "imq_beta": 0.5,
    "eta": 0.2,
    "repulsion": 1.0,
    "min_radius_fraction": 0.25,
    "learning_rate": 0.0002,
    "learning_rate_end": 0.000002,
    "learning_rate_decay_start": 30000,
    "learning_rate_decay_end": 50000,
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "ema_decay": 0.999,
    "log_every": 100,
    "checkpoint_every": 1000,
    "validation_holdout": 10000,
    "validation_every": 1000,
    "validation_generated_samples": 10000,
    "validation_batch_size": 512,
    "validation_positive_references": 1024
  }
}
