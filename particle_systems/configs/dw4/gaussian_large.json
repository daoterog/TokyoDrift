{
  "system": "dw4",
  "drift": {
    "space": "particle_coordinates",
    "kernel": "gaussian",
    "normalized": false
  },
  "data": "particle_systems/data/dw4.npz",
  "output": "particle_systems/artifacts/runs/dw4/gaussian-large",
  "seed": 42,
  "model": {
    "feature_dim": 8,
    "hidden_dim": 128,
    "layers": 6,
    "radial_basis": 24,
    "max_distance": 8.0
  },
  "training": {
    "epochs": 1000,
    "batch_size": 2048,
    "positive_references": 2048,
    "coordinate_noise_scale": 1.0,
    "bandwidth": [0.02, 0.5, 1.0],
    "eta": 0.3,
    "repulsion": 1.0,
    "min_radius_fraction": 0.25,
    "learning_rate": 0.0002,
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "ema_decay": 0.999,
    "log_every": 2,
    "checkpoint_every": 20
  }
}
