{
  "system": "dw4",
  "drift": {
    "space": "particle_coordinates",
    "kernel": "gaussian",
    "normalized": false
  },
  "data": "particle_systems/data/dw4.npz",
  "output": "particle_systems/artifacts/runs/dw4/gaussian",
  "seed": 42,
  "model": {
    "feature_dim": 8,
    "hidden_dim": 64,
    "layers": 4,
    "radial_basis": 16,
    "max_distance": 8.0
  },
  "training": {
    "epochs": 77,
    "batch_size": 256,
    "positive_references": 256,
    "coordinate_noise_scale": 2.5,
    "bandwidth": "auto",
    "bandwidth_scale_start": 1.5,
    "bandwidth_scale_end": 0.5,
    "bandwidth_anneal_start": 26,
    "bandwidth_anneal_end": 77,
    "eta": 0.2,
    "repulsion": 1.0,
    "min_radius_fraction": 0.25,
    "learning_rate": 0.0002,
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "ema_decay": 0.999,
    "log_every": 1,
    "checkpoint_every": 3
  }
}
