{
  "system": "lj55",
  "drift": {
    "space": "particle_coordinates",
    "kernel": "gaussian",
    "normalized": false,
    "descriptors": true
  },
  "data": "particle_systems/data/lj55.npz",
  "output": "particle_systems/artifacts/runs/lj55/gaussian",
  "seed": 42,
  "model": {
    "feature_dim": 8,
    "hidden_dim": 128,
    "layers": 9,
    "radial_basis": 16,
    "max_distance": 4.0
  },
  "training": {
    "epochs": 30,
    "batch_size": 64,
    "positive_references": 64,
    "coordinate_noise_scale": 1.0,
    "bandwidth": [0.02, 0.05, 0.1, 0.15],
    "eta": 0.2,
    "repulsion": 1.0,
    "min_radius_fraction": 0.25,
    "learning_rate": 0.0002,
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "ema_decay": 0.999,
    "log_every": 1,
    "checkpoint_every": 6
  }
}
